{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mi Botica",
  "version": "1.0.0",
  "identifier": "com.mibotica.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mi Botica — Sistema de Gestión",
        "width": 1400,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mi Botica",
    "copyright": "© 2026 Mi Botica",
    "category": "Business",
    "shortDescription": "Sistema de gestión para boticas y farmacias",
    "longDescription": "Mi Botica es un sistema de gestión integral para boticas y farmacias: ventas (POS), inventario con control de lotes y vencimientos (FEFO), compras, caja, clientes, auditoría y reportes. Funciona de forma 100% local en tu PC, sin necesidad de internet ni de un servidor externo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
